# ── InsureAI Backend Environment Configuration Template ──────────────
# Copy this file to server/.env and adjust configuration.

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
MONGO_DB_NAME=insurai

# ── FastAPI Backend ───────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
ENVIRONMENT=development
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=*
UPLOAD_DIR=uploads/policies

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openrouter | nvidia | groq
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenRouter (alternative - set LLM_PROVIDER=openrouter and fill key)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# NVIDIA NIM (alternative - set LLM_PROVIDER=nvidia and fill key)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama3-8b-instruct

# ── Embedding Provider ────────────────────────────────────────────────────────
# Options: ollama | api
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# API-based embeddings (set EMBEDDING_PROVIDER=api for OpenAI-compatible)
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# ── ChromaDB Vector Store ─────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_store

# ── Chunking & Retrieval ──────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5

# ── OCR Fallback ──────────────────────────────────────────────────────────────
OCR_TEXT_THRESHOLD=50
