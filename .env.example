# ── InsurAI — Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in the values for your setup.
# Never commit the actual .env file with production secrets.

# ── MongoDB Database Configuration ──────────────────────────────────────────
MONGO_URI=mongodb+srv://rohanjagdishsomani_db_user:N62wBcWLZNdmGwN7@insurai.v3ucvhs.mongodb.net
MONGO_DB_NAME=insurai

# ── FastAPI Backend Server ───────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
JWT_SECRET=insurai_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads/policies

# ── Vector Store (ChromaDB) ───────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=policy_chunks
CHROMA_PERSIST_DIR=./chroma_store

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openrouter | nvidia
LLM_PROVIDER=ollama

# Ollama (local) — no key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# NVIDIA NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama3-8b-instruct

# ── Embedding Provider ────────────────────────────────────────────────────────
# Options: ollama | api
EMBEDDING_PROVIDER=ollama

# Ollama embeddings — pull first: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# API-based embeddings (OpenAI-compatible)
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# ── Chunking & Retrieval ──────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5

# ── OCR Fallback ──────────────────────────────────────────────────────────────
OCR_TEXT_THRESHOLD=50
