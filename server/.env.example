# ─────────────────────────────────────────────────────────────────────────────
# InsureAI server — environment configuration template
# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored; this file (server/.env.example) is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=insurai

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
ALLOWED_ORIGINS=http://localhost:5173

# ── Google OAuth (Optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# ── Email / SMTP (Password Reset & Verification) ──────────────────────────────
# In local development without SMTP credentials, verification links are safely
# displayed in server console logs and returned in API responses for instant testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@insurai.com
SMTP_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# ── LLM provider (Groq — default) ────────────────────────────────────────────
# Options: groq | openrouter | nvidia
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── Embedding provider — Ollama (primary, local) ──────────────────────────────
# Ollama must be running: `ollama serve`
# Pull model first:       `ollama pull nomic-embed-text`
#
# Docker note: when using docker-compose, set OLLAMA_BASE_URL=http://ollama:11434
# (the `ollama` service name resolves inside the Docker network).
#
# If Ollama is unavailable, ChromaDB built-in embeddings are used as a
# fallback automatically (a WARNING is logged).
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30


# ── ChromaDB vector store ─────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_store
