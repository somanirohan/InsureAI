# ── InsureAI RAG module — environment variables ───────────────────────────────
# Copy this file to .env (at the repo root, next to the app/ directory) and
# fill in the values for your chosen providers.
# The app/ module reads ONLY from this file — never from the system environment
# directly (except via pydantic-settings which reads .env automatically).

# ── LLM provider ─────────────────────────────────────────────────────────────
# Options: ollama | openrouter | nvidia
LLM_PROVIDER=ollama

# Ollama (local) — no key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# NVIDIA NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama3-8b-instruct

# ── Embedding provider ────────────────────────────────────────────────────────
# Options: ollama | api
EMBEDDING_PROVIDER=ollama

# Ollama embeddings — pull first: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# API-based embeddings (OpenAI-compatible)
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=text-embedding-3-small

# ── Vector store ──────────────────────────────────────────────────────────────
# ChromaDB persistent directory (created automatically on first write)
CHROMA_PERSIST_DIR=./chroma_store

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5

# ── OCR ───────────────────────────────────────────────────────────────────────
# Pages with fewer characters than this threshold will trigger the OCR fallback
OCR_TEXT_THRESHOLD=50
