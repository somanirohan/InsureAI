        "title": "Cosmetic & Aesthetic Surgery",
        "text": "Clause 4.1: Cosmetic surgery, aesthetic treatments, and plastic surgery are permanently excluded except reconstructive surgery following an accidental injury.",
        "page": 6
      },
      {
        "clause_id": "ex_2",
        "clause_type": "exclusion",
        "title": "Robotic and Cyberknife Surgery",
        "text": "Clause 4.2: Robotic assisted surgeries and cyberknife treatments are excluded unless specifically pre-authorized for malignant neoplasm.",
        "page": 6
      },
      {
        "clause_id": "ex_3",
        "clause_type": "exclusion",
        "title": "Infertility and Assisted Reproduction",
        "text": "Clause 4.3: Infertility, IVF, ART, and sub-fertility treatments are strictly excluded under this policy.",
        "page": 7
      },
      {
        "clause_id": "wp_1",
        "clause_type": "waiting_period",
        "title": "Specific Disease 24 Month Waiting Period",
        "text": "Clause 3.2: A waiting period of 24 months applies for Cataract, Hernia, Hydrocele, and Joint Replacement surgeries.",
        "page": 4
      },
      {
        "clause_id": "wp_2",
        "clause_type": "waiting_period",
        "title": "Pre-Existing Disease 36 Month Waiting Period",
        "text": "Clause 3.1: Pre-existing diseases (PED) are covered only after 36 months of continuous coverage.",
        "page": 4
      },
      {
        "clause_id": "rr_1",
        "clause_type": "room_rent",
        "title": "Room Rent and Nursing Limit",
        "text": "Clause 2.1: Room Rent and nursing charges are covered up to 1% of Sum Insured per day. ICU charges are covered up to 2% of Sum Insured per day.",
        "page": 3
      },
      {
        "clause_id": "sub_1",
        "clause_type": "sub_limit",
        "title": "Cataract Procedure Sub-limit",
        "text": "Clause 2.4: Cataract surgery charges are subject to a sub-limit of Rs. 40,000 per eye.",
        "page": 5
      }
    ],
