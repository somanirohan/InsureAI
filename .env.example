# ─────────────────────────────────────────────────────────────────────────────
# InsureAI — environment configuration template
# Copy this file to .env and fill in real values.
# .env is git-ignored; this file (.env.example) is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=insurai

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
JWT_SECRET=replace_with_a_strong_random_secret

# ── LLM provider (Groq — default) ────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── Embedding provider — Ollama (primary, local) ──────────────────────────────
# Ollama must be running locally: `ollama serve`
# Pull the model first:         `ollama pull nomic-embed-text`
#
# If Ollama is unavailable, ChromaDB built-in embeddings are used as a
# fallback automatically (no additional configuration required).
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30


# ── ChromaDB vector store ─────────────────────────────────────────────────────
# Local persistence (default — no extra config needed):
CHROMA_PERSIST_DIR=./chroma_store

# Remote ChromaDB (uncomment if using a hosted instance):
# CHROMA_HOST=my-chroma.onrender.com
# CHROMA_PORT=443
# CHROMA_SSL=true
# CHROMA_API_KEY=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173
